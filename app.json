{
  "expo": {
    "name": "bajate-po-app",
    "slug": "bajate-po-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a Bájate Po! acceder a la cámara para escanear el código QR del bando en la cancha."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Bájate Po! acceder a tu galería para cambiar tu foto de operador."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
